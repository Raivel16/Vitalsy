POSTGRES_DB=mi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password_ejemplo

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mi_db
DB_USER=postgres
DB_PASSWORD=password_ejemplo
DB_DATABASE=mi_db
DB_USERNAME=postgres

APP_KEY=
APP_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=80
DEMO_PASSWORD=password_ejemplo

# Alertas en tiempo real (RNF-01): Laravel Reverb. En produccion use claves aleatorias y
# REVERB_SCHEME=https (wss) detras del proxy TLS (RNF-05).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=vitalsy
REVERB_APP_KEY=vitalsy-local-key
REVERB_APP_SECRET=vitalsy-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
# Solo produccion (obligatorios en docker-compose.prod.yml; sin valor por defecto):
#   REVERB_APP_KEY / REVERB_APP_SECRET aleatorios y REVERB_ALLOWED_ORIGINS=https://su-dominio
# La clave publica se incrusta en el build web mediante VITE_REVERB_APP_KEY (build arg).
PORT=3000
