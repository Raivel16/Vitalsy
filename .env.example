POSTGRES_DB=mi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password_ejemplo

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mi_db
DB_USER=postgres
DB_PASSWORD=password_ejemplo
DB_DATABASE=mi_db
DB_USERNAME=postgres

APP_KEY=
DEMO_PASSWORD=password_ejemplo
# Zona horaria de la aplicacion (turnos del e-MAR 07-19, SLA). Por defecto America/Lima.
# APP_TIMEZONE=America/Lima
# Solo desarrollo con HTTPS: nginx exige docker/nginx/certs/dev.crt|dev.key (no se versionan).
# Genérelos una vez con: bash docker/nginx/generate-dev-certs.sh

# Alertas en tiempo real (RNF-01): Laravel Reverb. En produccion use claves aleatorias y
# REVERB_SCHEME=https (wss) detras del proxy TLS (RNF-05).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=vitalsy
REVERB_APP_KEY=vitalsy-local-key
REVERB_APP_SECRET=vitalsy-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
# Solo produccion (obligatorios en docker-compose.prod.yml; sin valor por defecto):
#   REVERB_APP_KEY / REVERB_APP_SECRET aleatorios y REVERB_ALLOWED_ORIGINS=https://su-dominio
# La clave publica se incrusta en el build web mediante VITE_REVERB_APP_KEY (build arg).

# Produccion (docker-compose.prod.yml, RNF-05): dominio publico sin esquema y URL https
# PUBLIC_DOMAIN=vitalsy.example.org
# APP_URL=https://vitalsy.example.org
# SANCTUM_STATEFUL_DOMAINS=vitalsy.example.org
# TLS_CERTS_DIR=./certs
