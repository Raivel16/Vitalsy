{
  "expo": {
    "name": "Vitalsy Life",
    "slug": "vitalsy-life",
    "scheme": "vitalsylife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "life.vitalsy.app"
    },
    "android": {
      "package": "life.vitalsy.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Vitalsy Life usa la cámara para leer el código QR de la hoja de alta."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnectPermissions",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
