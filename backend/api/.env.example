PORT=3000
APP_NAME=Vitalsy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database_db
DB_USER=database_user
DB_PASSWORD=password_ejemplo
DB_DATABASE=database_db
DB_USERNAME=database_user

DEMO_PASSWORD=password_ejemplo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# RNF-05 (produccion): cookie solo por HTTPS y proxies de confianza (por defecto rangos privados; '*' solo si lo decide).
# SESSION_SECURE_COOKIE=true
# APP_URL=https://<dominio>   (obligatorio en docker-compose.prod.yml, igual que PUBLIC_DOMAIN y SANCTUM_STATEFUL_DOMAINS)
# TRUSTED_PROXIES=172.16.0.0/12
# En produccion SANCTUM_STATEFUL_DOMAINS debe ser solo el dominio https publico (sin localhost).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,localhost:5173,localhost:8080,127.0.0.1,127.0.0.1:8000,*.devops.local

# Alertas en tiempo real (RNF-01). 'reverb' en despliegue; 'log'/'null' sin servidor WebSocket.
BROADCAST_CONNECTION=log
REVERB_APP_ID=vitalsy
REVERB_APP_KEY=vitalsy-local-key
REVERB_APP_SECRET=vitalsy-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Solo desarrollo; en produccion defina el dominio https (por defecto restrictivo si APP_ENV=production).
REVERB_ALLOWED_ORIGINS=*
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
