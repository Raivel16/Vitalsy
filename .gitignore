# Root
.env
.env.*
!.env.example
!.env.e2e.example

# Node
node_modules/
dist/
dist-ssr/
.vite/
coverage/

# Python
__pycache__/
.venv/
venv/
*.pyc

# Artefactos de compilacion (plantilla oficial de evaluacion)
build/
target/

# Coverage and reports
coverage.xml
*.info
*.xml
!backend/api/phpunit.xml
# Reportes de cobertura normalizados para SonarQube
!coverage-reports/
!coverage-reports/*
!frontend/web/phpunit.xml

# Laravel / PHP
vendor/
public/hot
storage/*.key
storage/app/*.php
storage/app/public/
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache

# Restos locales del traslado de módulos (caché y sqlite; el código vive en backend/api)
services/backend/

# Docker
*.log
docker/postgres/data/
docker/nginx/certs/
!docker/nginx/certs/.gitkeep

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# graphify (grafo local regenerable)
graphify-out/

# SonarQube
.scannerwork/
movil/coverage/

# Certificados TLS de produccion (RNF-05): nunca se versionan
/certs/

# Documentos PDF de la actividad de patentes (pesados; no se versionan)
docs/actividad-19-patentes/*.pdf

# Material no funcional (solo local; no se versiona para aligerar el repo)
/bibliography/
/UI/
/docs/informe/
/docs/actividad-19-patentes/
/docs/resumen-ejecutivo/
/.cursor/
/scripts/load/

# Herramientas de calidad solo locales (la entrega no las incluye)
/scripts/

# Código .ino del ESP32-C3 SuperMini (historial en repo Git propio, nunca se sube)
/firmware-esp32c3/

# RNF-90: la suite e2e (Playwright) no se sube; vive en local con copia en D:\salva vitalsy.
# Así el zip de GitHub y SonarQube miden solo lo que se entrega.
frontend/web/e2e/
frontend/web/playwright.config.ts
frontend/web/tsconfig.e2e.json
docker-compose.e2e.yml
.env.e2e.example
.github/workflows/browser-matrix.yml
