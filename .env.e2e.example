# RNF-18: variables del stack E2E (copie a .env.e2e; nunca reutilice el .env de desarrollo).
# APP_KEY: genere una con
#   docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Deben coincidir (el compose los lee por separado).
POSTGRES_DB=vitalsy_e2e
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Clave-E2E-2026
DB_NAME=vitalsy_e2e
DB_USER=postgres
DB_PASSWORD=Clave-E2E-2026

# Contraseña de las cuentas demo {rol}@vitalsy.local que usa la suite.
DEMO_PASSWORD=Demo-E2E-2026

REVERB_APP_ID=vitalsy
REVERB_APP_KEY=vitalsy-local-key
REVERB_APP_SECRET=vitalsy-local-secret
